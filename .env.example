# Frontend environment configuration.
#
# Copy to `.env.local` (git-ignored) and adjust. Only `NEXT_PUBLIC_*` variables
# are exposed to the browser, so never put a secret here — every value in this
# file is readable by anyone who loads the page.

# Base URL of the Phase 2 backend, including the version prefix.
# Must match the host/port uvicorn is bound to, and that origin must appear in
# the backend's CORS_ORIGINS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
