# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real values. The documented templates are the one
# deliberate exception: they hold no secrets and are needed to set the project up.
.env*
!.env.example
!backend/.env.example

# python / backend
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling (machine-specific absolute paths)
.claude/
