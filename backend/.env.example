# Copy to `backend/.env` and adjust. `.env` is gitignored and must never be
# committed. The values below are development defaults, not secrets; the real
# POSTGRES_PASSWORD and the Angel One credentials belong in `.env`, which is
# the reason this loading path exists. There is still no authentication on the
# API itself.

APP_NAME="NIFTY Trading Agent API"
APP_VERSION=0.2.0
SERVICE_NAME=nifty-trading-agent-api

# development | staging | production
# Anything other than `development` disables /docs, /redoc and /openapi.json.
ENVIRONMENT=development
DEBUG=false

API_V1_PREFIX=/api/v1

# Explicit browser origins allowed to call this API. Comma-separated.
# Never set this to "*": the CORS middleware runs with credentials enabled.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Exchange-local timezone for all trading-domain dates.
TIMEZONE=Asia/Kolkata

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Repository backend
# ---------------------------------------------------------------------------
# postgres | mock
#
# `postgres` is the real one and the default. `mock` runs the API entirely in
# memory, which is useful on a machine without Docker and is what the unit
# suite uses. It is a configuration switch, not a fallback: nothing selects it
# automatically, and an unreachable database surfaces as a 503 rather than as
# quietly invented figures.
REPOSITORY_BACKEND=postgres

# ---------------------------------------------------------------------------
# PostgreSQL / TimescaleDB
# ---------------------------------------------------------------------------
# Supplied as parts rather than one DSN. A password containing `@` or `/`
# breaks a hand-assembled connection string silently; letting the URL type do
# the escaping removes the class of bug. These values must match the ones
# docker-compose.yml starts the container with.
POSTGRES_DB=trading_agent
POSTGRES_USER=trading_agent
POSTGRES_PASSWORD=trading_agent_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Connection pool. Deliberately modest: this is a single-user dashboard
# backend, and an oversized pool only moves the queue into PostgreSQL, which
# has a far lower connection ceiling than an application does.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
# Retire a connection before an idle-connection proxy silently kills it.
DB_POOL_RECYCLE=1800
# Echo every statement. Useful when debugging a query, far too noisy otherwise,
# and it would log bound parameters.
DB_ECHO=false

# Ceiling on the health endpoint's `SELECT 1`, in seconds. Sized from
# measurement: ~2,170 ms for the first (cold) connection on the development
# stack, ~5 ms once pooled. A 2.0 s budget reported a healthy database as
# `timeout` on the very first request.
DB_HEALTH_TIMEOUT=5.0

# ---------------------------------------------------------------------------
# Angel One SmartAPI — read-only, and off by default
# ---------------------------------------------------------------------------
# Every field below is optional. The API boots, serves the whole dashboard and
# passes its test suite with none of them set; a broker is something this
# system talks to, not something it needs permission from in order to start.
#
# Leave ANGEL_ONE_ENABLED=false unless you have deliberately filled in all four
# credentials. The switch exists so a half-populated `.env` cannot cause a
# surprise outbound login on startup — and nothing in this application logs in
# on startup in any case. The only thing that authenticates is
# `GET /api/v1/broker/connection-test`, and only when a human asks for it.
#
# NONE OF THESE MAY BE PREFIXED `NEXT_PUBLIC_`. Anything under that prefix is
# compiled into the JavaScript bundle and served to every visitor. The browser
# never receives an Angel One credential; it receives a masked client code and
# three booleans.
ANGEL_ONE_ENABLED=false

# From the SmartAPI "My Apps" registration. The API key is not a secret in the
# sense a password is, but it identifies your app to the broker and is treated
# as one here so it cannot leak through a repr or a traceback.
ANGEL_ONE_API_KEY=
# Your login/client code, e.g. A123456. Masked to `******56` before it reaches
# any response body.
ANGEL_ONE_CLIENT_CODE=
# The MPIN, as a string — a PIN may legitimately begin with a zero.
ANGEL_ONE_PIN=
# The base32 seed from the authenticator enrolment, NOT a six-digit code. The
# code expires in thirty seconds; the seed mints codes forever, which makes it
# the single most dangerous value in this file. It is read once, converted to a
# code inside `app.brokers.angel_one.auth`, and never stored, logged or passed
# to another layer.
ANGEL_ONE_TOTP_SECRET=

# Deployment fields from the same app registration. Declared so they are never
# hard-coded; no read-only flow in this phase uses any of them.
ANGEL_ONE_REDIRECT_URL=
ANGEL_ONE_POSTBACK_URL=
ANGEL_ONE_PRIMARY_STATIC_IP=
ANGEL_ONE_SECONDARY_STATIC_IP=

# Per-request ceiling for SmartAPI calls, in seconds. A guard against a hung
# socket, not a rate limiter — Angel One's own limits are far tighter (1–10
# requests per second depending on the route) and are tabulated in
# `app.brokers.angel_one.constants`.
ANGEL_ONE_TIMEOUT=10.0

# ---------------------------------------------------------------------------
# Order placement
# ---------------------------------------------------------------------------
# Both false, and setting either to true changes nothing: there is no order
# code for them to permit. No `place_order` exists on the adapter protocol, no
# order route exists on the API, and no order route constant exists in the
# Angel One constants module. These flags exist so the status endpoints can
# state the fact rather than leave it to be inferred.
LIVE_TRADING_ENABLED=false
PAPER_TRADING_ENABLED=false
