# Copy to `backend/.env` and adjust. `.env` is gitignored and must never be
# committed. No secrets exist in Phase 2 — there is no broker, no database and
# no authentication — but the loading path is established now so credentials
# have somewhere to live that is not source control.

APP_NAME="NIFTY Trading Agent API"
APP_VERSION=0.2.0
SERVICE_NAME=nifty-trading-agent-api

# development | staging | production
# Anything other than `development` disables /docs, /redoc and /openapi.json.
ENVIRONMENT=development
DEBUG=false

API_V1_PREFIX=/api/v1

# Explicit browser origins allowed to call this API. Comma-separated.
# Never set this to "*": the CORS middleware runs with credentials enabled.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Exchange-local timezone for all trading-domain dates.
TIMEZONE=Asia/Kolkata

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
